# ── NOVA multi-AI router — environment variables ─────────────────────
# Copy this file to `.env` for local development (`vite` auto-loads it),
# and add the same values as GitHub Actions secrets (Settings → Secrets and
# variables → Actions) so the deploy workflow can inject them at build time.
#
# All VITE_* vars are inlined into the client bundle at build, so treat them
# as public. Use provider keys with generous free tiers / rate limits.
#
# At minimum set VITE_GEMINI_KEY (the default + most common fallback). Every
# other key unlocks that provider; if it's missing the router just falls back
# to the next provider in the chain for that agent.

VITE_GEMINI_KEY=
VITE_GROQ_KEY=
VITE_DEEPSEEK_KEY=
VITE_MISTRAL_KEY=
VITE_COHERE_KEY=
VITE_OPENROUTER_KEY=
VITE_CEREBRAS_KEY=
VITE_HUGGINGFACE_KEY=
VITE_REPLICATE_KEY=
VITE_STABILITY_KEY=
VITE_ELEVENLABS_KEY=
VITE_TAVILY_KEY=
